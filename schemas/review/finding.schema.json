{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "DR review finding",
  "type": "object",
  "required": [
    "track",
    "rule_id",
    "title",
    "severity",
    "confidence",
    "category",
    "must_change",
    "summary",
    "impact",
    "recommendation",
    "evidence",
    "affected_sections",
    "requires_human_decision"
  ],
  "properties": {
    "finding_id": {"type": "string"},
    "track": {
      "enum": [
        "document_integrity",
        "br_traceability",
        "internal_consistency",
        "ui_ux_context",
        "technical_mapping"
      ]
    },
    "rule_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low", "observation"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "category": {"type": "string", "minLength": 1},
    "must_change": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "locator", "quote"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "evidence_type": {
            "enum": ["text", "visual_observation"]
          }
        },
        "additionalProperties": false
      }
    },
    "related_sources": {"type": "array", "items": {"type": "string"}},
    "affected_sections": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "requires_human_decision": {"type": "boolean"},
    "decision_question": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
