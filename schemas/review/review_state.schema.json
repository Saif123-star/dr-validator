{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_state.schema.json",
  "title": "DR review state",
  "type": "object",
  "required": [
    "schema_version",
    "function_key",
    "review_id",
    "status",
    "scope",
    "tracks",
    "created_at",
    "baseline_timestamp",
    "updated_at",
    "sources",
    "finding_count",
    "decision_count"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "function_key": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
    "status": {
      "enum": [
        "initialized",
        "sources_ready",
        "awaiting_scope",
        "reviewing",
        "merging",
        "verifying",
        "reconciling",
        "awaiting_decisions",
        "completed",
        "publication_planned",
        "publication_approved",
        "publishing",
        "published",
        "source_failed",
        "review_failed",
        "verification_failed",
        "publication_failed"
      ]
    },
    "scope": {"enum": ["full", "targeted"]},
    "tracks": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_timestamp": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": ["string", "null"]},
    "dr_page_id": {"type": ["string", "null"]},
    "dr_version": {"type": ["string", "null"]},
    "br_page_id": {"type": ["string", "null"]},
    "br_version": {"type": ["string", "null"]},
    "sources": {"type": "array", "items": {"type": "object"}},
    "finding_count": {"type": "integer", "minimum": 0},
    "decision_count": {"type": "integer", "minimum": 0},
    "function_map_count": {"type": "integer", "minimum": 0},
    "previous_review_id": {"type": ["string", "null"]},
    "publication": {
      "type": ["object", "null"],
      "properties": {
        "publication_id": {"type": "string"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planned_at": {"type": "string", "format": "date-time"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]},
        "page_id": {"type": ["string", "null"]},
        "page_url": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "last_error": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": true
}
